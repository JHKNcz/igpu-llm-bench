  - ryzen-ai
  - radeon-890m
  - strix-point
  - vulkan
  - rocm
  - llama.cpp
  - speculative-decoding
  - roofline
# No repository URL is recorded here on purpose: the repository is private and
# the account name would identify the owner. Cite the title and version instead.
